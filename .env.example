# Server-only AI configuration. Never expose this key to client code.
# The app calls the Anthropic Messages API; AI_BASE_URL points it at a gateway.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_BASE_URL=https://hnd1.aihub.zeabur.ai

# Legacy name, still read as a fallback so existing deployments keep working.
# OPENAI_MODEL is intentionally ignored — set AI_MODEL instead.
OPENAI_API_KEY=

# AI rate limits. The three per-caller windows are counted per client IP; the
# shared window is one budget for the whole deployment and is the only limit an
# attacker rotating IP addresses cannot walk around. Leave unset to use the
# defaults below; set a window to 0 to turn it off.
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60
AI_RATE_LIMIT_PER_DAY=200
AI_RATE_LIMIT_SHARED_PER_DAY=1000
