# Server-only AI configuration. Never expose this key to client code.
# The app calls the Anthropic Messages API; AI_BASE_URL points it at a gateway.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_BASE_URL=https://hnd1.aihub.zeabur.ai

# Legacy name, still read as a fallback so existing deployments keep working.
# OPENAI_MODEL is intentionally ignored — set AI_MODEL instead.
OPENAI_API_KEY=
